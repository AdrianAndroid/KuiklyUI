
#use_frameworks!
source 'https://cdn.cocoapods.org/'

target 'iosApp' do
  platform :ios, '14.1'
  pod 'SDWebImage', '~> 5.20.1'
  pod 'OpenKuiklyIOSRender', :path => '../'
  pod 'demo', :path => '../demo'
  pod 'WMPlayer', "~> 5.0" # 第三方播放器库
  pod 'libpag', "~> 4.3.21"
  # SFTP client deps (§2 / §3 / §21.1.1)
  # SSH/SFTP：与 macOS 使用同一个 ridenui fork（2.7.2，内置 libssh2 1.10.0）。
  # 官方 NMSSH 2.3.1 内置 libssh2 1.8.0，与服务器 OpenSSH 8.9 握手失败
  # （实测：TCP 通 → "Failure establishing SSH session" → connect 返回 1001）。
  pod 'NMSSH', :podspec => '../macApp/NMSSH.podspec'
  pod 'GCDWebServer', '~> 3.5.4'    # 本地 HTTP 代理
end


post_install do |installer|
  installer.pods_project.targets.each do |target|
    if target.name == 'OpenKuiklyIOSRender'
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_BITCODE'] = 'NO'
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = "YES"
      end
    end
  end
end
